# ==============================================================================
# National Unified Material Master Framework — Environment Configuration
# SIH 2026 Reference Template (DO NOT COMMIT REAL PRODUCTION SECRETS)
# ==============================================================================

# Application & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="AI-Powered National Unified Material Master Framework"

# Backend & API Configuration
API_V1_STR=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Security & Tokens (Change in Production)
SECRET_KEY=dev_secret_key_change_in_production_min_32_characters_sih2026
CSRF_SECRET_KEY=dev_csrf_secret_key_change_in_production_sih2026
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=material_master
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/material_master

# Redis & Celery Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Optional Cloud LLM (For complex edge-case reasoning)
# GEMINI_API_KEY=your_gemini_api_key_here
